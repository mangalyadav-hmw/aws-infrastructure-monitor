# AWS credentials (prefer IAM role / OIDC in production; use keys only for local dev)
AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Target infrastructure (read-only monitoring references)
AWS_EC2_PRIVATE_IP=172.31.9.87
# AWS_EC2_INSTANCE_ID=i-0123456789abcdef0
AWS_RDS_DB_IDENTIFIER=whibedev-db

# Monitoring behavior
MONITORING_CACHE_TTL_SECONDS=45
MONITORING_REQUEST_TIMEOUT_MS=30000

# Optional dashboard API protection (server-side header: x-dashboard-secret)
# DASHBOARD_API_SECRET=

# Direct SSH monitoring (local/VPS deployments with network reachability)
# SSH_HOST=
SSH_PORT=22
# SSH_USERNAME=monitor
# SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----"

# Recommended for Vercel: on-host read-only agent reachable over HTTPS
# SSH_AGENT_URL=https://your-server.example.com:9443
# SSH_AGENT_SECRET=

# Optional RDS direct read-only connection (not required when CloudWatch metrics are enabled)
# RDS_DATABASE_URL=postgresql://monitor_user:rotate_me@whibedev-db.c5m8086sy6fl.ap-south-1.rds.amazonaws.com:5432/postgres
